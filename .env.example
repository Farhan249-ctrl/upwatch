# MongoDB Configuration
MONGO_ROOT_USER=upwatch_admin
MONGO_ROOT_PASSWORD=replace_with_a_secure_password
MONGO_DB=upwatch
MONGO_PORT=27018

# Security & API Configuration
JWT_SECRET=replace_with_a_random_jwt_secret_at_least_32_characters_long
API_PORT=4000
ALLOW_PRIVATE_TARGETS=true

# Worker & Retention Configuration (defaults)
CHECK_RETENTION_DAYS=30
WORKER_TICK_SECONDS=5
WORKER_CONCURRENCY=10
FAILURE_THRESHOLD=2
